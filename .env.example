# Local development values only (MinIO runs on this machine). Copy to .env; .env is git-ignored.
MINIO_ROOT_USER=sgtl-local
MINIO_ROOT_PASSWORD=sgtl-local-dev-only
# Read-only mount for Airflow: the DataMall raw folder of the sg-bus-network-monitor repo
SOURCE_DIR_HOST=/path/to/sg-bus-network-monitor/data/raw/datamall

# Settings for running the pipeline from the host against the stack
LAKE_ROOT=s3://sgtl-lake
S3_ENDPOINT=localhost:29000
AWS_ACCESS_KEY_ID=sgtl-local
AWS_SECRET_ACCESS_KEY=sgtl-local-dev-only
KAFKA_BOOTSTRAP=localhost:29092
SOURCE_DIR=/path/to/sg-bus-network-monitor/data/raw/datamall
DUCKDB_PATH=/root/lakehouse-data/stack/warehouse.duckdb
# LTA_KEY is only needed for `python -m lakehouse live`; export it in your shell, never write it here.
